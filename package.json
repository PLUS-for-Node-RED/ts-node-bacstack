{
  "name": "@plus4nodered/ts-node-bacnet",
  "version": "1.0.0-beta.2",
  "description": "A BACnet® protocol stack written in pure TypeScript.",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "debug": "^4.4.3",
    "iconv-lite": "^0.7.2"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"source/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"source/**/*.{ts,tsx}\"",
    "test": "npm run typecheck && npm run test:ts",
    "test:ts": "jest -c jest.config.ts --coverage --coverageDirectory reports/coverage-test --bail source/test/unit/*.spec.ts",
    "integration": "jest --coverageDirectory reports/coverage-integration source/test/integration/*.spec.ts",
    "compliance": "jest --coverageDirectory reports/coverage-compliance source/test/compliance/*.spec.ts",
    "docs": "typedoc --out docs --entryPoint '\"client\"' --excludeExternals --excludeNotExported --excludePrivate source/lib/client.ts",
    "dev-link": "npm install && npm run build && npm link",
    "dev-unlink": "npm unlink @plus4nodered/ts-bacstack -g"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HILA-TECH/ts-node-bacstack.git"
  },
  "keywords": [
    "plus4nodered",
    "bacnet",
    "bacstack",
    "building",
    "automation"
  ],
  "author": {
    "name": "PLUS for Node-RED",
    "email": "developers@plus4nodered.com",
    "url": "http://plus4nodered.com"
  },
  "contributors": [
    {
      "name": "Fabio Huser",
      "email": "fabio@fh1.ch"
    },
    {
      "name": "Klaus Landsdorf",
      "email": "klaus@bianco-royal.de"
    }
  ],
  "engines": {
    "node": ">= 20"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/test/**/*"
  ],
  "homepage": "https://hila-tech.github.io/ts-node-bacstack/",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HILA-TECH/ts-node-bacstack/issues"
  },
  "devDependencies": {
    "@jest/globals": "^29.3.1",
    "@types/debug": "^4.1.7",
    "@types/jest": "^29.2.5",
    "@types/node": "^16.18.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jest": "^29.3.1",
    "ts-jest": "^29.0.3",
    "typescript-eslint": "^8.58.0",
    "typescript": "^5.9.3"
  }
}
